APP_NAME="BRR Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=brr_portal
DB_USERNAME=root
DB_PASSWORD=

# Isolated Database Migrations Table
DB_MIGRATIONS_TABLE=migrations_brr_portal

# Isolated Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_TABLE=sessions_brr_portal
SESSION_COOKIE=brr_portal_session

# Isolated Queue & Job Tables
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs_brr_portal
DB_QUEUE=brr_portal_default
DB_JOB_BATCHES_TABLE=job_batches_brr_portal
DB_FAILED_JOBS_TABLE=failed_jobs_brr_portal

# Isolated Cache & Lock Tables
CACHE_STORE=database
DB_CACHE_TABLE=cache_brr_portal
DB_CACHE_LOCK_TABLE=cache_locks_brr_portal
CACHE_PREFIX=brr_portal_cache_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare Turnstile Bot Protection
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

VITE_APP_NAME="${APP_NAME}"
